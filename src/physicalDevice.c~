#include "physicalDevice.h"

bool pickPhysicalDevice(Vulkan* vulkan, PhysicalDevice* physicalDevice) 
{
    vulkan->result = vkEnumeratePhysicalDevices(vulkan->instance, &physicalDevice->physicalDeviceCount, NULL);
    
    if (vulkan->result != VK_SUCCESS || physicalDevice->physicalDeviceCount == 0) {
	if (vulkan->result == VK_SUCCESS) vulkan->result = VK_ERROR_INITIALIZATION_FAILED;
	logMessage(LOG_ERROR, "Physical Device not found [%d]\n", vulkan->result);
	goto clean;
    }
    
    physicalDevice->physicalDevices = malloc(sizeof(*physicalDevice->physicalDevices) * physicalDevice->physicalDeviceCount);
    vulkan->result = vkEnumeratePhysicalDevices(vulkan->instance, &physicalDevice->physicalDeviceCount, physicalDevice->physicalDevices);
    if (vulkan->result != VK_SUCCESS || physicalDevice->physicalDeviceCount == 0) {
	if (vulkan->result == VK_SUCCESS) vulkan->result = VK_ERROR_INITIALIZATION_FAILED;
	logMessage(LOG_ERROR, "Physical Device not found [%d]\n", vulkan->result);
	goto clean;
    }

    struct VkPhysicalDeviceProperties physicalDeviceProperties;
    for (uint32_t i = 0; i < physicalDevice->physicalDeviceCount; ++i) {
	vkGetPhysicalDeviceProperties(physicalDevice->physicalDevices[i], &physicalDeviceProperties);
	if (physicalDeviceProperties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) {
	    vulkan->physicalDevice = physicalDevice->physicalDevices[i];
	    break;
	}
	vulkan->physicalDevice = physicalDevice->physicalDevices[i];
    }

    uint32_t queueFamilyPropertyCount;
    vkGetPhysicalDeviceQueueFamilyProperties(vulkan->physicalDevice, &queueFamilyPropertyCount, NULL);
    physicalDevice->queueFamilyProperties = malloc(sizeof(*physicalDevice->queueFamilyProperties) * queueFamilyPropertyCount);
    vkGetPhysicalDeviceQueueFamilyProperties(vulkan->physicalDevice, &queueFamilyPropertyCount, 
					     physicalDevice->queueFamilyProperties);
    bool supportGraphics = false;
    for (uint32_t i = 0; i < queueFamilyPropertyCount; ++i) {
	if (physicalDevice->queueFamilyProperties[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
	    supportGraphics = true;
	    physicalDevice->graphicsIndex = i;
	    break;
	}
    }
    vkGetPhysicalDeviceProperties(vulkan->physicalDevice, &physicalDeviceProperties);
    logMessage(LOG_INFO, "Selected GPU: [%s]\n", physicalDeviceProperties.deviceName);
    if (!supportGraphics) {
	vulkan->result = VK_ERROR_INITIALIZATION_FAILED;
	logMessage(LOG_ERROR, "[%s]: Graphics queue not supported\n", physicalDeviceProperties.deviceName);
	goto clean;
    }
    logMessage(LOG_INFO, "[%s]: Supported graphics\n", physicalDeviceProperties.deviceName);

    uint32_t extensionPropertyCount;
    vulkan->result = vkEnumerateDeviceExtensionProperties(vulkan->physicalDevice, NULL, &extensionPropertyCount, NULL);
    if (vulkan->result != VK_SUCCESS) {
	logMessage(LOG_ERROR, "Physical Device not supported extensions [%d]\n", vulkan->result);
	goto clean;
    }
    physicalDevice->extensionProperties = malloc(sizeof(*physicalDevice->extensionProperties) * extensionPropertyCount); 
    vulkan->result = vkEnumerateDeviceExtensionProperties(vulkan->physicalDevice, 
							  NULL, &extensionPropertyCount, physicalDevice->extensionProperties);
    if (vulkan->result != VK_SUCCESS) {
	logMessage(LOG_ERROR, "Physical Device not supported extensions [%d]\n", vulkan->result);
	goto clean;
    }

    const char *requiredDeviceExtensions[] = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
    physicalDevice->deviceExtensionCount = sizeof(requiredDeviceExtensions) / sizeof(requiredDeviceExtensions[0]);
    physicalDevice->deviceExtensions = malloc(sizeof(*physicalDevice->deviceExtensions) * physicalDevice->deviceExtensionCount);
    memcpy(physicalDevice->deviceExtensions, requiredDeviceExtensions, 
	   sizeof(*physicalDevice->deviceExtensions) * physicalDevice->deviceExtensionCount);

    for (uint32_t i = 0; i < physicalDevice->deviceExtensionCount; ++i) {
	bool found = false;
	for (uint32_t j = 0; j < extensionPropertyCount; ++j) {
	    if (strcmp(physicalDevice->extensionProperties[j].extensionName, 
		       physicalDevice->deviceExtensions[i]) == 0) {
		found = true;
		logMessage(LOG_INFO, "Required physical device extension [%s] is supported\n", requiredDeviceExtensions[i]);
		break;
	    }
	}
	if (!found) {
	    vulkan->result = VK_ERROR_INITIALIZATION_FAILED;
	    logMessage(LOG_ERROR, "Required physical device extension not supported: [%s]\n", requiredDeviceExtensions[i]);
	    goto clean;
	}
    }

    vulkan->result = VK_SUCCESS;
 clean:
    free(physicalDevice->extensionProperties);
    free(physicalDevice->queueFamilyProperties);
    free(physicalDevice->physicalDevices);

    physicalDevice->extensionProperties = NULL;
    physicalDevice->queueFamilyProperties = NULL;
    physicalDevice->physicalDevices = NULL;
    return (vulkan->result == VK_SUCCESS) ? true : false; 
}
